# =====================================================================
# Implantação Consulte GEO · frontend — variáveis de ambiente
#
# Copie para `.env` (local) e preencha. No Netlify, configure as mesmas
# chaves em Site settings → Environment variables.
#
# NUNCA commitar o `.env` real. A ANON KEY é publicável por design
# (RLS fechada + RPCs por token), mas a SERVICE ROLE KEY jamais pode
# aparecer aqui ou em qualquer código de frontend.
# =====================================================================

# URL do projeto Supabase (Implantação Consulte GEO)
VITE_SUPABASE_URL=https://yglcnirbnbwjqpvalqif.supabase.co

# Chave pública (anon) do projeto — Settings → API no painel Supabase
VITE_SUPABASE_ANON_KEY=coloque_aqui_a_anon_key

# Ambiente lógico: preview | production
VITE_APP_ENV=preview

# Nome exibido/telemetria
VITE_APP_NAME=Implantacao Consulte GEO
