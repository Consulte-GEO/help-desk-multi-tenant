# ============================================================================
# Implantação Consulte GEO — variáveis de ambiente (frontend)
#
# Copie para `.env` e preencha com os valores reais. NUNCA commite o `.env`
# (já coberto pelo .gitignore). No Netlify, defina as mesmas chaves em
# Site settings → Environment variables.
#
# Apenas variáveis prefixadas com VITE_ são expostas ao browser pelo Vite.
# A anon key é pública por design (viaja no bundle) — a proteção dos dados
# depende das policies RLS no Supabase, NÃO do sigilo desta chave.
# NUNCA use a service_role key aqui: ela ignora RLS. Ela só existe nas
# Edge Functions, injetada pelo próprio Supabase.
# ============================================================================

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave anônima (anon/publishable) do projeto Supabase
VITE_SUPABASE_ANON_KEY=

# Ambiente lógico da aplicação: preview | production
VITE_APP_ENV=preview

# Nome exibido da aplicação
VITE_APP_NAME=Implantacao Consulte GEO
