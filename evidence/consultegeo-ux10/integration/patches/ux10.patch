+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createOpeningFlow,openingIssues,openingFingerprint} from '../web/opening-flow.js';
+const valid=()=>({context:'authorized-context',subject:'Uma solicitação válida',description:'Resultado esperado e problema observado.',priority:'normal',coverage:''});
+const runtime={status:'ready',canSubmit:true,pending:false,unresolved:false,ambiguous:false};
+const ready=()=>{const s=createOpeningFlow();s.update(runtime);return s;};
+test('review requires three Unicode characters before a new opening intent',()=>{const s=ready(),v={...valid(),subject:'😀😀'};assert.equal(s.next(v),true);assert.equal(s.next(v),false);assert.deepEqual(openingIssues(v,runtime).map(x=>x.field),['subject']);v.subject='😀😀a';assert.equal(s.next(v),true);assert.equal(s.allowSubmit(v),true);});
+test('starts on context and refuses a disconnected catalog',()=>{const s=createOpeningFlow();assert.equal(s.view().step,1);assert.equal(s.next(valid()),false);assert.equal(s.allowSubmit(valid()),false);});
+test('three explicit steps, no submission at first or second step',()=>{const s=ready(),v=valid();assert.equal(s.allowSubmit(v),false);assert.equal(s.next(v),true);assert.equal(s.view().step,2);assert.equal(s.allowSubmit(v),false);assert.equal(s.next(v),true);assert.equal(s.view().step,3);assert.equal(s.allowSubmit(v),true);});
+test('empty/whitespace and length limits produce targeted human errors',()=>{const v=valid();v.subject='  ';v.description='';assert.deepEqual(openingIssues(v,runtime).map(x=>x.field),['subject','description']);v.subject='x'.repeat(201);v.description='x'.repeat(12001);assert.equal(openingIssues(v,runtime).length,2);});
+test('invalid Unicode and unknown priority are rejected by presentation',()=>{const v=valid();v.subject='ab\0c';v.description='test\uD800';v.priority='root';assert.equal(openingIssues(v,runtime).length,3);});
+test('snapshot changed without an input event cannot be submitted',()=>{const s=ready(),v=valid();s.next(v);s.next(v);v.subject='Outro assunto';assert.equal(s.allowSubmit(v),false);});
