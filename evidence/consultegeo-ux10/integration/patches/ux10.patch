+  --hd-brand-fg-light: #244A9A; --hd-brand-fg-dark: #A5C7FF;
+  --hd-selection-light: #EEF3FE; --hd-selection-dark: #1C3159;
+  --hd-grad-brand: linear-gradient(135deg, #17396E 0%, #204782 55%, #285AD6 100%);
+  --hd-nav: #14263F; --hd-nav-raised: #203753; --hd-nav-ink: #F0F4FF;
+  --hd-nav-muted: #BFCCE6; --hd-nav-line: #485E7C;
+  --hd-focus-on-dark: #F3B1DB;
+  font-family: var(--hd-font); font-synthesis: none;
+  /* Compatibility aliases let optional components consume the same semantics. */
+  --green: var(--hd-accent); --ink: var(--hd-ink); --muted: var(--hd-muted);
+  --line: var(--hd-line); --border: var(--hd-line); --surface: var(--hd-surface);
+  --surface-2: var(--hd-surface-2); --nav: var(--hd-nav);
+  --paper: var(--hd-paper); --ink-soft: var(--hd-muted); --ink-faint: var(--hd-subtle);
+  --success: var(--hd-success-fg); --warning: var(--hd-warning-fg);
