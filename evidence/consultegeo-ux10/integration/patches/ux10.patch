+import test from 'node:test';import assert from 'node:assert/strict';import {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';import {createHash} from 'node:crypto';
+import {validateVisualReport} from '../scripts/test-visual-local.mjs';
+/** Synthetic report inputs test the CI verifier; they are never browser evidence. */
+async function fixture(work:(root:string,r:Record<string,unknown>)=>Promise<void>){const root=await mkdtemp(join(tmpdir(),'hd-visual-report-'));try{await mkdir(join(root,'web'));const bytes='owned-source';await writeFile(join(root,'web/app.js'),bytes);const r={mode:'offline-full-app-synthetic-transport',original_controller_replaced:false,legacy_css_loaded:true,cases:[{name:'owned',passed:true,checks:1}],passed:1,failed:0,checks:[{name:'owned',passed:true}],source_sha256:{'web/app.js':createHash('sha256').update(bytes).digest('hex')}};await work(root,r);}finally{await rm(root,{recursive:true,force:true});}}
+const policy={minimum:1,cases:1,requiredSources:['web/app.js']};
+test('visual CI verifier refuses a passed summary containing a failed check',()=>fixture(async(root,r)=>{r.checks=[{name:'owned',passed:false}];await assert.rejects(validateVisualReport(root,r,'app',policy));}));
+test('visual CI verifier refuses a report for different source bytes',()=>fixture(async(root,r)=>{await writeFile(join(root,'web/app.js'),'different');await assert.rejects(validateVisualReport(root,r,'app',policy));}));
+test('visual CI verifier refuses incomplete cases and replaced app controllers',()=>fixture(async(root,r)=>{r.cases=[];await assert.rejects(validateVisualReport(root,r,'app',policy));r.cases=[{name:'owned',passed:true,checks:1}];r.original_controller_replaced=true;await assert.rejects(validateVisualReport(root,r,'app',policy));}));
+test('visual CI verifier refuses missing required source and escaping file paths',()=>fixture(async(root,r)=>{r.source_sha256={'../web/app.js':'a'.repeat(64)};await assert.rejects(validateVisualReport(root,r,'app',policy));r.source_sha256={};await assert.rejects(validateVisualReport(root,r,'app',policy));}));
+test('visual CI verifier accepts coherent owned source without claiming platform approval',()=>fixture(async(root,r)=>{const checks=await validateVisualReport(root,r,'app',policy);assert.deepEqual(checks,[{check:'app: owned',result:'passed'}]);}));
