+function configuration(){return parseConsulteGeoCustomerConfiguration({schema:1,product:'CONSULTE_GEO',id:id(1),version:1,contentHash:'a'.repeat(64),service:'user_access',title:'Acesso de usuários',entries:[['include','Incluir usuário'],['change','Alterar usuário'],['disable','Desativar usuário'],['resend_access','Reenviar acesso'],['grant_work_access','Liberar em nova obra']].map(([action,label],i)=>({action,priority:'normal',label,form:{...schema(),id:id(10+i)},serviceWindow:{firstResponseHours:2,resolutionHours:8,reopenDays:5,timeZone:'America/Sao_Paulo'}}))});}
