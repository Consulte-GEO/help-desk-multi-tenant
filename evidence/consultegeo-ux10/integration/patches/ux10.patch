+  --hd-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --hd-radius-sm: 10px; --hd-radius-md: 14px; --hd-radius-lg: 18px; --hd-radius-xl: 24px;
