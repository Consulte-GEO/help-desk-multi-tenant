+
+test('UX10 build keeps M04 and M09 operational assets alongside all visual modules',()=>{const text=readFileSync(new URL('../scripts/build.mjs',import.meta.url),'utf8');for(const name of ['consultegeo-request.js','consultegeo-request.css','consultegeo-intake-api.js','consultegeo-configuration.js','consultegeo-configuration.css','access-feedback.js','portal-ui.js'])assert.ok(text.includes(name),name);});
