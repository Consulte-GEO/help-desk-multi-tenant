+import test from 'node:test';import assert from 'node:assert/strict';
+import {captureGeoCallback,createGeoAuthController} from '../web/geo-auth-state.js';
+const id=(n:number)=>'00000000-0000-4000-8000-'+String(n).padStart(12,'0');
+const callback={code:'PRIVATE_CODE',state:'s'.repeat(43),iss:'https://origin.example.invalid'};
+const receipt=()=>({principal_id:id(2),workspace_id:id(1),access_token:'hd_person_'+'a'.repeat(43),refresh_token:'hd_person_refresh_'+'b'.repeat(43),expires_at:'2026-10-13T23:00:00.000Z',absolute_expires_at:'2026-10-14T00:00:00.000Z',return_path:'/portal'});
+const url='https://helpdesk.example.invalid/auth/geo/callback?code=PRIVATE_CODE&state='+callback.state+'&iss='+encodeURIComponent(callback.iss);
+test('UX08 GEO URL is cleaned even when callback is invalid',()=>{for(const suffix of ['#private','&state=duplicate','&token=SECRET']){const clean:string[]=[];assert.equal(captureGeoCallback({href:url+suffix},{replaceState(_a:any,_b:any,p:string){clean.push(p);}}),null);assert.deepEqual(clean,['/auth/geo/callback']);}});
+test('UX08 GEO capture returns payload without dispatch',()=>{let clean='';const x=captureGeoCallback({href:url},{replaceState(_a:any,_b:any,p:string){clean=p;}});assert.deepEqual(x,callback);assert.equal(clean,'/auth/geo/callback');});
+test('UX08 original GEO controller is dormant before explicit completion',()=>{let calls=0;const c=createGeoAuthController({request:async()=>{calls++;return Response.json(receipt());}});assert.equal(calls,0);assert.equal(c.view().authenticated,false);assert.equal(c.accessToken(),null);c.destroy();});
+test('UX08 GEO duplicated completion consumes a callback only once',async()=>{let calls=0;const c=createGeoAuthController({request:async()=>{calls++;return Response.json(receipt());}});const a=c.complete(callback),b=c.complete(callback);assert.deepEqual(await Promise.all([a,b]),[true,false]);assert.equal(calls,1);assert.equal(c.view().authenticated,true);assert.ok(!JSON.stringify(c.view()).includes('hd_person'));c.destroy();});
+test('UX08 GEO refusal cannot be rendered as success or retried automatically',async()=>{let calls=0;const c=createGeoAuthController({request:async()=>{calls++;return new Response('PRIVATE_SERVER_BODY',{status:410});}});assert.equal(await c.complete(callback),false);assert.equal(await c.complete(callback),false);assert.equal(calls,1);assert.equal(c.view().authenticated,false);assert.ok(!c.view().message.includes('PRIVATE'));c.destroy();});
+test('UX08 GEO incompatible receipt is not adopted',async()=>{for(const bad of [{...receipt(),return_path:'https://evil.invalid'},{...receipt(),extra:'PRIVATE'},{...receipt(),access_token:'wrong'}]){const c=createGeoAuthController({request:async()=>Response.json(bad)});assert.equal(await c.complete(callback),false);assert.equal(c.accessToken(),null);c.destroy();}});
+test('UX08 GEO late response after cancellation is ignored',async()=>{let resolve!:Function,adopted=0;const c=createGeoAuthController({request:()=>new Promise(r=>resolve=r),onSession:()=>adopted++});const p=c.complete(callback);c.destroy();resolve(Response.json(receipt()));assert.equal(await p,false);assert.equal(adopted,0);assert.equal(c.accessToken(),null);});
+test('UX08 GEO synchronous host mount failure removes stored credentials',async()=>{const c=createGeoAuthController({request:async()=>Response.json(receipt()),onSession:()=>{throw Error('PRIVATE_HOST');}});assert.equal(await c.complete(callback),false);assert.equal(c.accessToken(),null);assert.ok(!c.view().message.includes('PRIVATE_HOST'));c.destroy();});
