+test('UX10 new operational screens use the shared theme without mounting themselves',()=>{for(const file of ['consultegeo-request.css','consultegeo-configuration.css']){const css=readFileSync(new URL('../web/'+file,import.meta.url),'utf8');assert.match(css,/var\(--hd-surface/);assert.match(css,/focus-visible/);assert.match(css,/prefers-reduced-motion/);const html=readFileSync(new URL('../web/index.html',import.meta.url),'utf8');assert.ok(html.includes('href="/'+file+'"'));}const app=readFileSync(new URL('../web/app.js',import.meta.url),'utf8');assert.ok(!app.includes('mountConsulteGeoRequest'));assert.ok(!app.includes('mountConsulteGeoConfigurationEditor'));});
