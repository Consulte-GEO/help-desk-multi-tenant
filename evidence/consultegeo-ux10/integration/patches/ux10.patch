+for(const unknown of ['toString','__proto__','constructor','<img src=x onerror=alert(1)>','hd_person_PRIVATE_TOKEN',null,0,{},undefined])test('UX08 unknown codes never reflect input '+String(unknown),async()=>{const m=await moduleApi();assert.equal(typeof m.loginErrorText,'function');assert.equal(m.loginErrorText(unknown),'Não foi possível entrar. Confira seus dados e tente novamente.');});
+test('UX08 arbitrary objects are not read as errors',async()=>{const m=await moduleApi();let touched=false;const input={get message(){touched=true;throw Error('PRIVATE');},get code(){touched=true;throw Error('PRIVATE');},toString(){touched=true;return 'PRIVATE';}};assert.equal(typeof m.loginErrorText,'function');assert.equal(m.loginErrorText(input),'Não foi possível entrar. Confira seus dados e tente novamente.');assert.equal(touched,false);});
+test('UX08 only sign-in is presented as signing-in busy; security phases are not reactivated',async()=>{const m=await moduleApi();assert.equal(typeof m.accessPhase,'function');assert.deepEqual(m.accessPhase('signing_in'),{kind:'signing_in',loginBusy:true,sessionTone:'neutral'});assert.equal(m.accessPhase('paused').sessionTone,'warning');assert.equal(m.accessPhase('refreshing').sessionTone,'info');for(const phase of ['enrolling_mfa','requesting_recovery','verifying_mfa','toString',null])assert.equal(m.accessPhase(phase).kind,'other');});
