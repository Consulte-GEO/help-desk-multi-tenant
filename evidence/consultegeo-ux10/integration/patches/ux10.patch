+
+test('UX10 renderer delivers both callback contracts once with immutable operational answers',()=>{const r=dom();let visual=0;const values:unknown[]=[];const form=mountDynamicForm(host(r),{schema:schema(),onAnswersChange:()=>visual++,onChange:(v:unknown)=>values.push(v)});const f=elements(r).find(e=>e.attributes['data-field']==='name')!;f.value='Maria';f.dispatch('input');assert.equal(visual,1);assert.deepEqual(values,[{name:'Maria'}]);assert.ok(Object.isFrozen(values[0]));form.destroy();});
+
+test('UX10 canEdit forbids programmatic row writes and value changes',()=>{const r=dom();const s=schema([textField,{key:'rows',type:'repeater',label:'Linhas',required:false,public:true,config:{fields:[textField],minRows:0,maxRows:3}}]);const form=mountDynamicForm(host(r),{schema:s,answers:{name:'Original'},canEdit:()=>false});assert.throws(()=>form.addRow('rows'));const f=elements(r).find(e=>e.attributes['data-field']==='name')!;f.value='Proibido';f.dispatch('input');assert.deepEqual(form.draftAnswers(),{name:'Original'});form.destroy();});
+
+test('UX10 async reference cannot arrive while owner has locked its intent',async()=>{const r=dom();let allowed=true,resolve!:(v:unknown)=>void;const form=mountDynamicForm(host(r),{schema:schema([lookup]),canEdit:()=>allowed,chooseLookup:()=>new Promise(r=>resolve=r)});const p=form.choose('person');allowed=false;resolve('person_1');await p;assert.deepEqual(form.draftAnswers(),{});form.destroy();});
+
+test('UX10 hiding and showing a conditional field invalidates the old reference generation',async()=>{const r=dom();let resolve!:(v:unknown)=>void;const s=schema([{key:'enabled',type:'boolean',label:'Outra pessoa',required:true,public:true,config:{}},{...lookup,when:{field:'enabled',equals:true}}]);const form=mountDynamicForm(host(r),{schema:s,answers:{enabled:true},chooseLookup:()=>new Promise(r=>resolve=r)});const p=form.choose('person');for(const value of ['false','true']){const f=elements(r).find(e=>e.attributes['data-field']==='enabled')!;f.value=value;f.dispatch('change');}resolve('old_person');await p;assert.deepEqual(form.draftAnswers(),{enabled:true});form.destroy();});
+
+test('UX10 intake mount propagates pending/saved phases to the operational journey',async()=>{const r=dom();const phases:string[]=[];const panel=mountSupportIntake(host(r),{...intakeOptions(),onChange:s=>phases.push(s.phase)});await panel.state.save();assert.ok(phases.includes('saving'));assert.ok(phases.includes('saved'));panel.destroy();});
+
+test('UX10 rejected reconciliation must not release a previously ambiguous opening',async()=>{const opts=intakeOptions();const calls:unknown[]=[];let attempt=0;const state=createSupportIntakeState({...opts,api:{...opts.api,create:async(payload,key)=>{calls.push({payload,key});attempt++;if(attempt===1)throw Error('ACK lost');if(attempt===2)return {kind:'rejected'};return {kind:'confirmed',value:{ticketId:id(30),protocol:'CG-10001',notification:'pending'}};}}});await state.save();await state.preview();await state.confirm();assert.equal(state.snapshot().phase,'unknown');await state.reconcile();assert.equal(state.snapshot().phase,'unknown');assert.throws(()=>state.edit({answers:{},subject:'Other',description:'other',coverageId:null}));await state.reconcile();assert.equal(state.snapshot().phase,'confirmed');assert.deepEqual(calls[0],calls[1]);assert.deepEqual(calls[1],calls[2]);state.clear();});
