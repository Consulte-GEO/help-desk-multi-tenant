# Backend ONLY. Never prefix private values with VITE_, NEXT_PUBLIC_, PUBLIC_.
SUPABASE_URL=https://xaelbntjnvztznnpcvtm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_IN_SECRET_MANAGER
# Obtain exact restricted-user Supavisor connection settings in the project dashboard.
HELPDESK_DATABASE_URL=
# Optional PEM CA, managed as a server-only secret. TLS verification is ALWAYS enabled.
HELPDESK_DATABASE_CA=
# Keep false until database, security, runtime, rate limits and recovery gates are approved.
HELPDESK_RELEASE_APPROVED=false

# Server-only random HMAC key: 32 random bytes encoded as base64url. Never send to clients.
HELPDESK_RATE_LIMIT_HMAC_KEY=

# Consulte GEO M06. Enable only after code/schema/source qualification.
HELPDESK_CONSULTEGEO_ADMINISTRATION=false
HELPDESK_CONSULTEGEO_WORKFLOW=false
HELPDESK_CONSULTEGEO_INTAKE=false
# Exact HTTPS app origin required for either module.
HELPDESK_CONSULTEGEO_ORIGIN=
