{
  "name": "@consulte-geo/helpdesk",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=tap tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:db": "node --experimental-strip-types --test --test-reporter=tap --test-concurrency=1 supabase/tests/rls.test.ts supabase/tests/upgrade.test.ts",
    "check:contracts": "node --experimental-strip-types scripts/check-contracts.ts",
    "build": "node scripts/build-implantacao.mjs && node scripts/build.mjs",
    "dev": "netlify dev",
    "verify": "npm run check:migrations && npm run check:consultegeo-upgrade && npm test && npm run typecheck && npm run check:contracts && npm run check:secrets && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:lock": "node scripts/verify-lock.mjs",
    "deps:resolve": "node scripts/prepare-dependencies.mjs --resolve",
    "test:db:local": "node scripts/test-db-local.mjs",
    "verify:release": "npm run check:lock && npm run check:homologation && npm run verify && npm audit --audit-level=high",
    "homologate:local": "node scripts/homologate-local.mjs",
    "check:homologation": "node scripts/check-homologation.mjs",
    "test:ui:local": "node scripts/test-ui-local.mjs",
    "logs:summary": "node --experimental-strip-types scripts/summarize-http-logs.ts",
    "test:db:native": "node scripts/test-db-native.mjs",
    "check:migrations": "node --experimental-strip-types scripts/check-migrations.ts",
    "scopes:plan": "node --experimental-strip-types scripts/plan-human-scopes.ts",
    "bootstrap:plan": "node --experimental-strip-types scripts/plan-first-admin.ts",
    "runtime:preflight": "node --experimental-strip-types scripts/runtime-preflight.ts",
    "test:tls:local": "node --experimental-strip-types --test --test-reporter=tap tests/m1-preflight-tls.test.ts",
    "integration:check": "node scripts/check-integration.mjs",
    "test:hosted:read": "node --experimental-strip-types scripts/hosted-acceptance.ts",
    "test:hosted:auth": "node --experimental-strip-types scripts/hosted-auth-acceptance.ts",
    "test:hosted:write": "node --experimental-strip-types scripts/hosted-write-acceptance.ts",
    "knowledge:audit": "node scripts/knowledge-source-audit.mjs",
    "knowledge:review": "node scripts/knowledge-editorial-review.mjs",
    "check:consultegeo-upgrade": "node --experimental-strip-types scripts/check-consultegeo-upgrade.ts",
    "recovery:inventory": "node --experimental-strip-types scripts/recovery-inventory.ts"
  },
  "dependencies": {
    "openai": "7.34.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@netlify/functions": "6.0.0",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.8.3"
  }
}
