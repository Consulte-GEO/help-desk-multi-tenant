{
  "name": "@consulte-geo/helpdesk",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:db": "node --experimental-strip-types --test supabase/tests/*.test.ts",
    "check:contracts": "node --experimental-strip-types scripts/check-contracts.ts",
    "build": "node scripts/build.mjs",
    "dev": "netlify dev",
    "verify": "npm test && npm run typecheck && npm run check:contracts && npm run check:secrets && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:lock": "node scripts/verify-lock.mjs",
    "deps:resolve": "node scripts/prepare-dependencies.mjs --resolve",
    "test:db:local": "node scripts/test-db-local.mjs",
    "verify:release": "npm run check:lock && npm run check:homologation && npm run verify && npm audit --audit-level=high",
    "homologate:local": "node scripts/homologate-local.mjs",
    "check:homologation": "node scripts/check-homologation.mjs",
    "test:ui:local": "node scripts/test-ui-local.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@netlify/functions": "4.2.5",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "typescript": "5.8.3"
  }
}
