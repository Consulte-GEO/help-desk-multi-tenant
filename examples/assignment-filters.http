# Server-to-server example only. No credentials included.
# A HUMAN operator session is required; M2M cannot use assignment filters.
@base = https://helpdesk.example.invalid
@workspace = 11111111-1111-4111-8111-111111111111
@token = REPLACE_WITH_AUTHORIZED_HUMAN_SESSION

### Own authorized tickets; can combine with status/priority/q
GET {{base}}/v1/tickets?assignment=mine&status=in_progress&limit=25
Authorization: Bearer {{token}}
X-Workspace-Id: {{workspace}}

### Unassigned authorized tickets, literal null owner (not inactive owner)
GET {{base}}/v1/tickets?assignment=unassigned&priority=high&limit=25
Authorization: Bearer {{token}}
X-Workspace-Id: {{workspace}}

# On the next page send the same filters and the returned cursor.
# Changing filters requires starting a new page. Assignment never grants access.
